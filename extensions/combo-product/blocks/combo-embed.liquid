<script>window.__COMBO_BUILDER_EMBED__ = true;</script>
{{- 'combo-builder.css' | asset_url | stylesheet_tag -}}
<script defer src="{{ 'combo-builder.js' | asset_url }}"></script>
<script>
  window.__COMBO_BUILDER_GLOBAL__ = {
    shop:           '{{ shop.permanent_domain }}',
    currency:       '{{ cart.currency.iso_code }}',
    currencySymbol: '{{ cart.currency.symbol }}',
    apiBase:        '/apps/product-builder'
  };

  {% if template.name == 'product' and product %}
  window.__COMBO_BUILDER__ = window.__COMBO_BUILDER__ || [];
  window.__COMBO_BUILDER__.push({
    mountId:        'combo-builder-auto-product-{{ product.id }}',
    shop:           '{{ shop.permanent_domain }}',
    currency:       '{{ cart.currency.iso_code }}',
    currencySymbol: '{{ cart.currency.symbol }}',
    apiBase:        '/apps/product-builder',
    customerId:     '{% if customer %}{{ customer.id }}{% endif %}',
    customerTags:   {% if customer %}{{ customer.tags | json }}{% else %}[]{% endif %},
    productId:      '{{ product.id }}',
    productHandle:  '{{ product.handle }}',
    autoProductBox: true,
    productBoxOnly: true,
    layoutMode: 'grid',
    boxTypeFilter:  '{{ block.settings.box_type_filter | default: "all" }}',
    visibleBoxes:   {{ block.settings.visible_boxes | json }}
  });
  {% endif %}
</script>

{% if template.name == 'product' and product %}
  <div
    id="combo-builder-auto-product-{{ product.id }}"
    class="combo-builder-root combo-builder-auto-product-root"
    data-cb-source="auto"
    data-shop="{{ shop.permanent_domain }}"
    data-currency="{{ cart.currency.iso_code }}"
    data-currency-symbol="{{ cart.currency.symbol }}"
    data-api-base="/apps/product-builder"
    data-customer-id="{% if customer %}{{ customer.id }}{% endif %}"
    data-customer-tags="{% if customer %}{{ customer.tags | join: ',' | escape }}{% endif %}"
    data-product-id="{{ product.id }}"
    data-product-handle="{{ product.handle }}"
    data-auto-product-box="true"
    data-product-box-only="true"
    data-layout-mode="grid"
    data-box-type-filter="{{ block.settings.box_type_filter | default: 'all' }}"
    data-visible-boxes="{{ block.settings.visible_boxes | escape }}"
  ></div>
{% endif %}

{% schema %}
{
  "name": "Build Your Box Auto",
  "target": "body",
  "settings": [
    {
      "type": "select",
      "id": "box_type_filter",
      "label": "Show bundle boxes",
      "options": [
        { "value": "all", "label": "All boxes" },
        { "value": "single", "label": "Single boxes" },
        { "value": "multiple", "label": "Multiple boxes" }
      ],
      "default": "all"
    },
    {
      "type": "textarea",
      "id": "visible_boxes",
      "label": "Visible boxes",
      "placeholder": "12345,45678,00123",
      "visible_if": "{{ block.settings.box_type_filter != 'all' }}",
      "info": "Optional. Enter box IDs, names, or 5-character box codes separated by commas or new lines. Leave blank to show every mapped box from the selected type."
    }
  ]
}
{% endschema %}
